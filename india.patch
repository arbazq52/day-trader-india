-def _yoy_match(series_, end, days=365, slack=10):
-    target = _date(end) - _dt.timedelta(days=days)
-    best = None
-    for e in series_:
-        gap = abs((_date(e) - target).days)
-        if gap <= slack and (best is None or gap < best[0]):
-            best = (gap, e)
-    return series_[best[1]] if best else None
